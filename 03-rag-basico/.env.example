# Chave da OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=coloque_sua_api_aqui

# Modelo de geração (chat)
MODEL=openai/gpt-4o-mini

# Modelo de embeddings
EMBEDDING_MODEL=openai/text-embedding-3-small

# "openrouter" = API real | "local" = embedder de hashing offline (sem custo,
# qualidade baixa, serve só para testar o pipeline sem chave)
EMBEDDING_PROVIDER=openrouter

# Parâmetros do pipeline
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
TEMPERATURE=0.0
MAX_TOKENS=600
